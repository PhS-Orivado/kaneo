    "/task/by-ticket-id/{ticketId}": {
      "get": {
        "operationId": "getTaskByTicketId",
        "tags": [
          "Tasks"
        ],
        "summary": "Get task by ticket ID",
        "description": "Get a single task by its project key and number, such as KAN-12. A match in an active project takes precedence, then the most recently archived project. If the ticket ID still matches multiple accessible tasks, narrow the lookup to a workspace with workspaceId or workspaceSlug, or to a single project with projectId.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "maxLength": 128,
              "description": "Project key and task number, e.g. KAN-12."
            },
            "required": true,
            "description": "Project key and task number, e.g. KAN-12.",
            "name": "ticketId",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "description": "Select a workspace if the ticket ID exists in more than one."
            },
            "required": false,
            "description": "Select a workspace if the ticket ID exists in more than one.",
            "name": "workspaceId",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "description": "Select a workspace by its slug instead of its ID."
            },
            "required": false,
            "description": "Select a workspace by its slug instead of its ID.",
            "name": "workspaceSlug",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "description": "Select a project if the ticket ID exists more than once."
            },
            "required": false,
            "description": "Select a project if the ticket ID exists more than once.",
            "name": "projectId",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Task details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskByTicketId"
                }
              }
            }
          },
          "400": {
            "description": "Invalid ticket ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "No accessible task has this ticket ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "Ticket ID matches multiple accessible tasks",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/ApiKeyRateLimited"
          }
        }
      }
    },
