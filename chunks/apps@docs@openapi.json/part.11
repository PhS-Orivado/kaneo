                  },
                  "status": {
                    "type": "string"
                  },
                  "projectId": {
                    "type": "string"
                  },
                  "position": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2147483646
                  },
                  "userId": {
                    "type": "string"
