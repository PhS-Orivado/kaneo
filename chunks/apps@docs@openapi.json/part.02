      "IntegrationSyncPreview": {
        "type": "object",
        "properties": {
          "isActive": {
            "type": "boolean"
          },
          "rules": {
            "type": "object",
            "properties": {
              "outgoing": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "mode": {
                        "type": "string",
                        "enum": [
                          "all"
                        ]
                      }
                    },
                    "required": [
                      "mode"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "mode": {
                        "type": "string",
                        "enum": [
                          "labels"
                        ]
                      },
                      "match": {
                        "type": "string",
                        "enum": [
                          "any",
                          "all"
                        ]
                      },
                      "labels": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128
                        },
                        "minItems": 1,
                        "maxItems": 50
                      }
                    },
                    "required": [
                      "mode",
                      "match",
                      "labels"
                    ]
                  }
                ],
                "description": "Kaneo workspace label IDs controlling task sync. Missing labels pause sync."
              },
              "incoming": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "mode": {
                        "type": "string",
                        "enum": [
                          "all"
                        ]
                      }
                    },
                    "required": [
                      "mode"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "mode": {
                        "type": "string",
                        "enum": [
                          "labels"
                        ]
                      },
                      "match": {
                        "type": "string",
                        "enum": [
                          "any",
                          "all"
                        ]
                      },
                      "labels": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128
                        },
                        "minItems": 1,
                        "maxItems": 50
                      }
                    },
                    "required": [
                      "mode",
                      "match",
                      "labels"
                    ]
                  }
                ],
                "description": "Exact repository label names controlling which issues can be imported."
              }
            },
            "required": [
              "outgoing",
              "incoming"
            ]
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "color": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "name",
                "color"
              ]
            }
          },
          "missingLabels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "total": {
            "type": "number"
          },
          "matching": {
            "type": "number"
          },
          "willCreate": {
            "type": "number"
          },
          "willPause": {
            "type": "number"
          },
          "needsReview": {
            "type": "number"
          },
          "paused": {
            "type": "number"
          },
          "matchingTasks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "number": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "title": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "number",
                "title"
              ]
            }
          },
          "pausedNextCursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "pausedTasks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "number": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "title": {
                  "type": "string"
                },
                "linkId": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                },
                "eligible": {
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "number",
                "title",
                "linkId",
                "url",
                "eligible"
              ]
            }
          },
          "previewToken": {
            "type": "string"
          }
        },
        "required": [
          "isActive",
          "rules",
          "labels",
          "missingLabels",
          "total",
          "matching",
          "willCreate",
          "willPause",
          "needsReview",
          "paused",
          "matchingTasks",
          "pausedNextCursor",
