                    "type": "boolean"
                  },
                  "ntfyEnabled": {
                    "type": "boolean"
                  },
                  "gotifyEnabled": {
                    "type": "boolean"
                  },
                  "webhookEnabled": {
                    "type": "boolean"
                  },
                  "projectMode": {
                    "type": "string",
                    "enum": [
                      "all",
                      "selected"
