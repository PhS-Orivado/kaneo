          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "content": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 10000
                  },
                  "externalUserName": {
                    "type": "string",
                    "maxLength": 120,
                    "description": "Attribution for an imported comment. Requires workspace:manage_settings and externalSource; otherwise ignored."
                  },
                  "externalSource": {
                    "type": "string",
                    "enum": [
                      "planka",
                      "trello",
                      "jira",
                      "plane",
                      "linear",
                      "kaneo"
                    ],
                    "description": "The tool the comment was imported from. Supplying external attribution requires workspace:manage_settings."
                  }
                },
                "required": [
                  "content"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The created comment",
