    "/github-integration/import-issues": {
      "post": {
        "operationId": "importGitHubIssues",
        "tags": [
          "GitHub"
        ],
        "summary": "Import GitHub issues",
        "description": "Import open issues and link open pull requests for one repository binding (integrationId) in bounded steps. Existing tasks are updated. Continue 202 responses with the returned runId until 200; the same runId safely retries completion. Progress is saved after each page and is per binding. A projectId in the body is accepted for compat and must match the binding's project.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "integrationId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "projectId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "runId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  }
                },
                "required": [
                  "integrationId"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Completed import summary",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IssueImportResult"
                }
              }
            }
          },
          "202": {
            "description": "Saved import progress; continue with runId",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IssueImportResult"
                }
              }
            }
          },
          "400": {
            "description": "integrationId is required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "No access to the project, or missing task:create or task:update permission",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Integration not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "Integration or import changed; refresh before resuming",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "429": {
            "description": "Import busy; retry after one second",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "502": {
            "description": "Provider unavailable or invalid page; progress is saved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/gitea-integration/repositories": {
      "post": {
        "operationId": "listGiteaRepositories",
        "tags": [
          "Gitea"
        ],
        "summary": "List Gitea repositories",
        "description": "List the repositories a Gitea token can reach, for picking one to link. Sent as a POST because the token travels in the body rather than the URL. Each repository is annotated with its linked state (RFC 0001 WP3): same-project links block selection, cross-project links are informational only (decision D1).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "projectId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "baseUrl": {
                    "type": "string",
                    "format": "uri"
                  },
                  "accessToken": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "projectId",
                  "baseUrl",
                  "accessToken"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Accessible repositories",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GiteaRepositoryList"
                }
              }
            }
          },
          "400": {
            "description": "Invalid body, or invalid Gitea credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "No access to the project, or missing workspace:manage_settings",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Project not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/ApiKeyRateLimited"
          }
        }
      }
    },
    "/gitea-integration/verify": {
      "post": {
        "operationId": "verifyGiteaAccess",
        "tags": [
          "Gitea"
        ],
        "summary": "Verify Gitea access",
        "description": "Check that the base URL is a Gitea instance and that the token can reach the repository with the permissions Kaneo needs. Repository permission failures are reported in the body; invalid credentials and upstream errors return an error status. Omit accessToken to use the saved token for the unchanged base URL.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "projectId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "baseUrl": {
                    "type": "string",
                    "format": "uri"
                  },
                  "accessToken": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Omit to verify with this project's saved token. The base URL must match the saved integration."
                  },
                  "repositoryOwner": {
                    "type": "string",
                    "minLength": 1
                  },
                  "repositoryName": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "projectId",
                  "baseUrl",
                  "repositoryOwner",
                  "repositoryName"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Verification result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GiteaVerificationResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid body, or invalid Gitea credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Kaneo authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "No access to the project, or missing workspace:manage_settings",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Project not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/ApiKeyRateLimited"
          },
          "500": {
            "description": "Gitea verification failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
