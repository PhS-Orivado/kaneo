      "ImportRun": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "workspaceId": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "enum": [
              "planka",
              "plane",
              "linear",
              "jira",
              "trello",
              "kaneo"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "running",
              "completed",
              "failed"
            ],
            "description": "completed once every selected project was attempted, even if some failed; check each project's status. failed means the run itself stopped."
          },
          "includeComments": {
            "type": "boolean"
          },
          "message": {
            "type": [
              "string",
              "null"
            ],
            "description": "Latest progress line while the run is running."
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "projects": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ImportRunProject"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "finishedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "workspaceId",
          "source",
          "status",
          "includeComments",
          "message",
          "error",
          "projects",
          "createdAt",
          "finishedAt"
        ]
      },
      "ImportRunProject": {
        "type": "object",
        "properties": {
          "sourceId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "running",
              "completed",
              "failed"
            ]
          },
          "projectId": {
            "type": [
              "string",
              "null"
            ],
            "description": "The Kaneo project created by the import, once completed."
          },
          "projectSlug": {
            "type": [
              "string",
              "null"
            ]
          },
          "counts": {
            "$ref": "#/components/schemas/ImportCounts"
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "sourceId",
