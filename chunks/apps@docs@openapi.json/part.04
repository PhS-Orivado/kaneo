      "ImportConnection": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/PlankaImportConnection"
          },
          {
            "$ref": "#/components/schemas/PlaneImportConnection"
          },
          {
            "$ref": "#/components/schemas/LinearImportConnection"
          },
          {
            "$ref": "#/components/schemas/JiraImportConnection"
          },
          {
            "$ref": "#/components/schemas/TrelloImportConnection"
          },
          {
            "$ref": "#/components/schemas/KaneoImportConnection"
          }
        ],
        "discriminator": {
          "propertyName": "source",
          "mapping": {
            "planka": "#/components/schemas/PlankaImportConnection",
            "plane": "#/components/schemas/PlaneImportConnection",
            "linear": "#/components/schemas/LinearImportConnection",
            "jira": "#/components/schemas/JiraImportConnection",
            "trello": "#/components/schemas/TrelloImportConnection",
            "kaneo": "#/components/schemas/KaneoImportConnection"
          }
        },
        "description": "Where to import from and how to sign in. Credentials are used only for this request and the import it starts; they are never stored, logged, or returned."
      },
      "PlankaImportConnection": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "planka"
            ]
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "description": "Address of the PLANKA instance.",
            "example": "https://planka.example.com"
          },
          "apiKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "description": "A PLANKA API key. Send it, or username and password. Used only for this import and never stored or logged."
          },
          "username": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Username or email of a PLANKA account, used with password when no API key is sent."
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "description": "Password of that PLANKA account. Used only for this import and never stored or logged."
          }
        },
        "required": [
          "source",
          "url"
        ]
      },
      "PlaneImportConnection": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "plane"
            ]
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "description": "Address of the Plane instance, e.g. https://app.plane.so for Plane Cloud.",
            "example": "https://planka.example.com"
          },
          "apiKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "description": "A Plane personal access token. Used only for this import and never stored or logged."
          },
          "workspaceSlug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Slug of the Plane workspace to read. Optional when the URL already names it."
          }
        },
        "required": [
          "source",
          "url",
          "apiKey"
        ]
      },
      "LinearImportConnection": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "linear"
            ]
          },
          "apiKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "description": "A Linear personal API key. Used only for this import and never stored or logged."
          }
        },
        "required": [
          "source",
          "apiKey"
        ]
      },
      "JiraImportConnection": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "jira"
            ]
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "description": "Address of the Jira site, e.g. https://your-site.atlassian.net for Jira Cloud, or your own domain for Jira Data Center.",
            "example": "https://your-site.atlassian.net"
          },
          "email": {
            "type": "string",
            "minLength": 1,
            "maxLength": 320,
            "description": "Email of the Atlassian account the API token belongs to. Required for Jira Cloud; leave it out for Jira Data Center."
          },
          "apiToken": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "description": "A Jira Cloud API token, sent with email, or a Jira Data Center personal access token, sent without email. Used only for this import and never stored or logged."
          }
        },
        "required": [
          "source",
          "url",
          "apiToken"
        ]
      },
      "TrelloImportConnection": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "trello"
            ]
          },
          "token": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "description": "A Trello token authorized for this Kaneo instance. Used only for this import and never stored or logged."
          },
          "apiKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Trello API key, a public app identifier. Defaults to the server's TRELLO_API_KEY."
          }
        },
        "required": [
          "source",
          "token"
        ]
      },
      "KaneoImportConnection": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "kaneo"
            ]
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "description": "Address of the Kaneo instance to import from.",
            "example": "https://planka.example.com"
          },
          "apiKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "description": "An API key from that Kaneo instance. Used only for this import and never stored or logged."
          }
        },
        "required": [
          "source",
          "url",
          "apiKey"
        ]
      },
      "ImportRunEnvelope": {
        "type": "object",
        "properties": {
          "run": {
            "$ref": "#/components/schemas/ImportRun"
          }
        },
        "required": [
