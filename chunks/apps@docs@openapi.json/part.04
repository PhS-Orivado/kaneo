 "expiresAt": {
                "type": "string",
                "format": "date-time"
              },
              "status": {
                "type": "string"
              },
              "expired": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "email",
              "workspaceName",
              "inviterName",
              "expiresAt",
              "status",
              "expired"
            ],
            "description": "Omitted when the invitation does not exist, was already accepted, or was canceled -- the details are withheld rather than leaked."
          },
          "error": {
            "type": "string",
            "description": "Why the invitation is unusable, when valid is false."
          }
        },
        "required": [
          "valid"
        ]
      },
      "Workspace": {
        "type": "object",
        "properties": {
          "id": {
