            "name": "installationPage",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,5}$",
              "default": "1"
            },
            "required": false,
            "name": "repositoryPage",
            "in": "query"
          }
