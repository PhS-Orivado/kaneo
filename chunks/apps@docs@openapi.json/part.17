                       "type": "string",
                                  "minLength": 1,
                                  "maxLength": 128
                                },
                                "minItems": 1,
                                "maxItems": 50
                              }
                            },
                            "required": [
                              "mode",
                              "match",
                              "labels"
                            ]
                          }
                        ],
                        "description": "Kaneo workspace label IDs controlling task sync. Missing labels pause sync."
                      },
                      "incoming": {
                        "oneOf": [
                          {
                            "type": "object",
                            "properties": {
                              "mode": {
                                "type": "string",
                                "enum": [
                                  "all"
                                ]
                              }
                            },
                            "required": [
                              "mode"
                            ]
                          },
                          {
                            "type": "object",
                            "properties": {
                              "mode": {
                                "type": "string",
                                "enum": [
                                  "labels"
                                ]
                              },
                              "match": {
                                "type": "string",
                                "enum": [
                                  "any",
                                  "all"
                                ]
                              },
                              "labels": {
                                "type": "array",
                                "items": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 128
                                },
                                "minItems": 1,
                                "maxItems": 50
                              }
                            },
                            "required": [
                              "mode",
                              "match",
                              "labels"
                            ]
                          }
                        ],
                        "description": "Exact repository label names controlling which issues can be imported."
                      }
                    },
                    "required": [
                      "outgoing",
                      "incoming"
                    ]
                  },
                  "previewToken": {
                    "type": "string",
                    "minLength": 64,
                    "maxLength": 64
                  }
                },
                "required": [
                  "rules",
                  "previewToken"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Saved rules and current scope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IntegrationSyncPreview"
                }
              }
            }
          },
          "400": {
            "description": "Invalid rule or workspace label",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "No access to the project, or missing required permission",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Project, integration, or linked task not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "Configuration, impact or comparison changed; review again",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/ApiKeyRateLimited"
          }
        }
      }
    },
