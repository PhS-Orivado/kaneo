    "/import/projects": {
      "post": {
        "operationId": "listImportSourceProjects",
        "tags": [
          "Import"
        ],
        "summary": "List projects in an import source",
        "description": "Sign in to PLANKA, Plane, Linear, Jira, Trello or another Kaneo instance and list the projects that can be imported. The credentials are used only for this request; they are never stored, logged, or returned.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "workspaceId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "connection": {
                    "$ref": "#/components/schemas/ImportConnection"
                  }
                },
                "required": [
                  "workspaceId",
                  "connection"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Projects available in the source",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportSourceProjectList"
                }
              }
            }
          },
          "400": {
            "description": "Invalid body, credentials the source rejected, or a destination this server may not reach",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "402": {
            "description": "Workspace plan has expired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Missing workspace:manage_settings or project:create permission",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Workspace not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/ApiKeyRateLimited"
          },
          "502": {
            "description": "The source could not be reached or answered with an error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/import/runs": {
      "post": {
        "operationId": "startImportRun",
        "tags": [
          "Import"
        ],
        "summary": "Start an import",
        "description": "Import the selected source projects into the workspace as new Kaneo projects. The import runs in the background; poll getImportRun for progress. The credentials are held in memory only while the import runs; they are never stored, logged, or returned. Imported tasks do not send notifications or trigger integrations.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "workspaceId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "connection": {
                    "$ref": "#/components/schemas/ImportConnection"
                  },
                  "projectIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512
                    },
                    "minItems": 1,
                    "maxItems": 50,
                    "description": "Source project IDs from listImportSourceProjects, imported in this order."
                  },
                  "includeComments": {
                    "type": "boolean",
                    "default": true,
                    "description": "Import task comments too. Defaults to true."
                  }
                },
                "required": [
                  "workspaceId",
                  "connection",
                  "projectIds"
                ]
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "The import started",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportRunEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid body, credentials the source rejected, a destination this server