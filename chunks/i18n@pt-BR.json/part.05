	"landing": {
		"sponsors": {
			"ciSponsor": "Parceiros"
		},
		"founder": {
			"title": "Why Kaneo exists",
			"intro": "I'm Andrej, and I created Kaneo because I was tired of project management tools that got in the way more than they helped. After years of using bloated, overcomplicated platforms that distracted from actual work, I knew there had to be a better way.",
			"problem": "The problem wasn't that these tools lacked features - it was that they had too many. Every notification, every unnecessary button, every complex workflow was pulling my team away from what mattered: building great products.",
			"principle": "I believe the best tools are invisible. They should amplify your team's natural workflow, not force you to adapt to theirs. Kaneo is built on the principle that less is more - every feature exists because it solves a real problem, not because it looks impressive in a demo."
		},
		"hero": {
			"cloudCta": "Try Kaneo Cloud",
			"selfHostCta": "Self-host Kaneo",
			"trialNote": "14-day cloud trial. No credit card required.",
			"github": "GitHub",
			"productHunt": "Product Hunt",
			"title": "Project management",
			"titleAccent": "that doesn't become the project.",
			"description": "Open-source project management with boards, Gantt charts, and GitHub integration. Self-host for free with SSO included, or let Kaneo Cloud handle the hosting."
		},
		"navigation": {
