		"product": {
			"title": "Before you get started",
			"description": "The practical details about hosting, planning, and connecting your team.",
			"overview": "Kaneo is an open-source, MIT-licensed project management platform with boards, backlog, Gantt and calendar views, custom fields, time tracking, and GitHub integration. Self-host it on your own infrastructure or use Kaneo Cloud.",
			"hosting": {
				"question": "Is Kaneo free to self-host?",
				"answer": "Yes. Kaneo is MIT licensed and free to self-host, with single sign-on included. Run the application alongside PostgreSQL using Docker Compose, or deploy with the official Helm chart. You manage infrastructure, updates, and backups.",
				"link": "Read the installation guide"
			},
			"planning": {
				"question": "Does Kaneo have Gantt charts?",
				"answer": "Yes. Kaneo includes Gantt and calendar views alongside boards, lists, and backlog planning. Use task start dates and due dates to plan work on a timeline. Budgeting, baseline comparisons, and sprint burndown reports are outside its current scope.",
				"link": "Compare planning features"
			},
			"sso": {
				"question": "Is single sign-on included?",
				"answer": "Yes. The free self-hosted build supports Google, GitHub, Discord, and custom OAuth/OIDC providers. Configure your provider on your instance without purchasing a separate Kaneo edition.",
				"link": "Configure OIDC"
			},
			"agents": {
				"question": "Can AI clients work with Kaneo?",
