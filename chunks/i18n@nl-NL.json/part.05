		"seo": {
			"title": "Kaneo — Open-source, self-hosted project management",
			"description": "Open-source project management with boards, Gantt charts, and GitHub integration. Self-host for free with SSO included, or use Kaneo Cloud."
		},
		"resources": {
			"eyebrow": "Make it your own",
			"title": "A clear path from trying it to using it.",
			"description": "Set up your server, connect your tools, or compare Kaneo with your current tracker.",
			"docker": {
				"title": "Self-host with Docker",
				"description": "Installation, backups, and updates for a setup you control."
			},
			"sso": {
				"title": "Bring your own identity provider",
				"description": "Configure OIDC single sign-on in the free self-hosted build."
			},
			"mcp": {
				"title": "Connect your AI tools",
				"description": "Use MCP to work with tasks and projects through an AI client."
			},
			"linear": {
				"title": "Compare Kaneo and Linear",
				"description": "See the differences in hosting, licensing, and workflow."
			}
		},
		"product": {
			"title": "Before you get started",
			"description": "The practical details about hosting, planning, and connecting your team.",
			"overview": "Kaneo is an open-source, MIT-licensed project management platform with boards, backlog, Gantt and calendar views, custom fields, time tracking, and GitHub integration. Self-host it on your own infrastructure or use Kaneo Cloud.",
			"hosting": {
				"question": "Is Kaneo free to self-host?",
				"answer": "Yes. Kaneo is MIT licensed and free to self-host, with single sign-on included. Run the application alongside PostgreSQL using Docker Compose, or deploy with the official Helm chart. You manage infrastructure, updates, and backups.",
				"link": "Read the installation guide"
			},
			"planning": {
				"question": "Does Kaneo have Gantt charts?",
				"answer": "Yes. Kaneo includes Gantt and calendar views alongside boards, lists, and backlog planning. Use task start dates and due dates to plan work on a timeline. Budgeting, baseline comparisons, and sprint burndown reports are outside its current scope.",
				"link": "Compare planning features"
			},
			"sso": {
				"question": "Is single sign-on included?",
				"answer": "Yes. The free self-hosted build supports Google, GitHub, Discord, and custom OAuth/OIDC providers. Configure your provider on your instance without purchasing a separate Kaneo edition.",
				"link": "Configure OIDC"
			},
			"agents": {
				"question": "Can AI clients work with Kaneo?",
				"answer": "Yes. Kaneo provides an MCP server through the @kaneo/mcp package and an HTTP endpoint. Compatible AI clients can read and update tasks using an API key tied to a user, subject to workspace permissions.",
				"link": "Read the MCP guide"
			}
		},
		"comparison": {
			"feature": "Feature",
			"yes": "Yes",
			"no": "No"
		},
		"selfHostingGuide": {
			"summary": "What self-hosting involves, with links to the maintained Docker Compose configuration and installation steps.",
			"answer": "To self-host Kaneo, run the application and PostgreSQL with Docker Compose, configure your public URL and secrets, and put a TLS reverse proxy in front. The installation guide specifies at least 2 GB of RAM and 10 GB of disk space. Plan for ongoing updates, database backups, and storage for uploaded files.",
			"requirements": "The documented minimum is 2 GB of RAM and 10 GB of disk space, with Docker 20.10 or newer and Docker Compose V2. Allow more capacity for your workload, database growth, and uploaded files.",
			"compose": "Use the maintained compose.yml in the Docker Compose guide. It defines PostgreSQL, a persistent database volume, the Kaneo application, and health checks. Configure the environment file before starting the services; for production, pin an image version so updates are deliberate.",
			"backups": "Back up both PostgreSQL and any object storage used for uploads. Choose a schedule based on how much work your team can afford to lose, store copies off the application server, and test restoring them before you need them.",
			"worth": "Self-hosting makes sense when you need control over infrastructure and data, and someone can own maintenance. Include server capacity, storage, backups, and that maintenance time when comparing costs with a managed service.",
			"minimum": "The installation guide specifies Docker 20.10 or newer, Docker Compose V2, at least 2 GB of RAM, and 10 GB of disk space. The Compose setup includes PostgreSQL. Redis is optional for a single API instance.",
			"composeLink": "Docker Compose configuration",
			"composeLinkDescription": "The maintained compose.yml with persistent storage and health checks.",
			"startLink": "Start and verify the services",
			"startLinkDescription": "Start the stack, inspect its status, and check that the application is available."
		}
	}
}
